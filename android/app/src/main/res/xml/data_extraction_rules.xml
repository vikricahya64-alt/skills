<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules untuk Android 12+ (cloud backup & transfer perangkat).
     Preferensi & WebView dipindahkan; data sensitif tetap dikecualikan. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="database" path="session.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>

# Salin file ini ke .env lalu isi kunci Anda.
# Kunci API Gemini gratis: https://aistudio.google.com/apikey
# Bisa berisi BEBERAPA key dipisah koma -> server otomatis rotasi saat satu key kena kuota (429)
GEMINI_API_KEY=your-gemini-api-key-here
# Opsional: pilih model. Default: auto (pilih flash-lite karena kuota gratisnya jauh lebih besar)
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=8080
